# Auto-populado pelo servidor (sandbox do Mitra) — NÃO hardcode valores.
# Localmente estas chaves ficam VAZIAS: o simulador não precisa delas e o
# mitra-sdk só é executado no sandbox (ver docs do projeto / skill mitra-escopo).
MITRA_BASE_URL=
MITRA_BASE_URL_INTEGRATIONS=
MITRA_TOKEN=
MITRA_PROJECT_ID=
MITRA_WORKSPACE_ID=

# WinThor (Oracle, JDBC externo) — spec 003 (add-003-jdbc-winthor.mjs). Preenchido
# só no .env do sandbox, nunca aqui nem em documento; nunca commitado.
WINTHOR_JDBC_URL=
WINTHOR_USER=
WINTHOR_PASSWORD=

# Simulador: com `oracle`, as sgcWint* leem o WinThor REAL (credenciais acima)
# em vez das PC* imitadas no SQLite. So numa maquina com acesso ao Oracle (a
# VPS). Vazio = SQLite, o padrao; check e smoke ignoram esta chave. Precisa do
# Oracle Instant Client (ldconfig ou ORACLE_CLIENT_LIB_DIR) — ver
# backend/simulator/README.md.
SIMULATOR_WINTHOR=
ORACLE_CLIENT_LIB_DIR=

# Simulador: com `mitra`, a INTEGRATION gestao-de-custos (unidades por caixa)
# consulta a plataforma em LEITURA com as variáveis SÓ deste adaptador —
# NUNCA preencha as MITRA_* acima na VPS: são as de escrita dos add-*.mjs.
# Vazio = SQLite (CUSTO_PRODUTOS do seed), o padrão; check e smoke ignoram.
SIMULATOR_GESTAO_CUSTOS=
GESTAO_CUSTOS_BASE_URL=
GESTAO_CUSTOS_TOKEN=
# 60574 = projeto Mitra VIVO do Gestão de Custos (p-46967 é só o nome do repositório do código dele).
GESTAO_CUSTOS_PROJECT_ID=60574
# Caminho: vazio = runQuery (token de desenvolvedor) com fallback para o REST
# GET /interactions/records (token business); `records` pula o runQuery.
GESTAO_CUSTOS_CAMINHO=
